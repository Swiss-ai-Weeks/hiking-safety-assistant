{
  "components": {
    "schemas": {
      "AltRoute": {
        "description": "The same route cut short: turn back at `stop_id` instead of going on over the crux.",
        "properties": {
          "duration": {
            "title": "Duration",
            "type": "string"
          },
          "grade": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "T5",
              "T6"
            ],
            "title": "Grade",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "const": "altRoute",
            "title": "Kind",
            "type": "string"
          },
          "place": {
            "title": "Place",
            "type": "string"
          },
          "stopId": {
            "title": "Stopid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "duration",
          "stopId",
          "place",
          "grade"
        ],
        "title": "AltRoute",
        "type": "object"
      },
      "Answer": {
        "description": "A language model's answer to a question about one route on one day, or why there is none.\n\n`text` is already filled in: the model wrote placeholders for every figure and the server put the\nengine's values there, after checking the rest carried no figure and no verdict. Absent unless\n`reason` is `ok`.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "reason": {
            "enum": [
              "ok",
              "dropped",
              "off_topic",
              "disabled",
              "unavailable",
              "emergency"
            ],
            "title": "Reason",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "enabled",
          "reason",
          "citations"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/AskTurn"
