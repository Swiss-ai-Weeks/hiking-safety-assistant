          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "RouteRequest",
        "type": "object"
      },
      "SeverityInterval": {
        "description": "A severity that holds from `from` up to, but not including, `to`.",
        "properties": {
          "from": {
            "title": "From",
            "type": "integer"
          },
          "severity": {
            "enum": [
              "none",
              "mod",
              "high"
            ],
            "title": "Severity",
            "type": "string"
          },
          "to": {
            "title": "To",
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to",
          "severity"
        ],
        "title": "SeverityInterval",
        "type": "object"
      },
      "StartEarlier": {
        "properties": {
          "dependsOn": {
            "title": "Dependson",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "const": "startEarlier",
            "title": "Kind",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "start",
          "dependsOn"
        ],
        "title": "StartEarlier",
        "type": "object"
      },
      "Stop": {
        "description": "A point on the day's timeline, in walking order (out and back).",
        "properties": {
          "breakMinutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Breakminutes"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlaceLabel"
              },
              {
                "$ref": "#/components/schemas/KeyLabel"
              }
            ],
            "title": "Label"
          },
          "legMinutes": {
            "title": "Legminutes",
            "type": "integer"
          },
          "waypointId": {
            "title": "Waypointid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "waypointId",
          "label",
          "legMinutes"
        ],
        "title": "Stop",
        "type": "object"
      },
      "StopConditions": {
        "description": "What the forecast says at a stop over `[from, to)`: the numbers the crux card shows.",
        "properties": {
          "feelsLikeC": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feelslikec"
          },
          "from": {
            "title": "From",
            "type": "integer"
          },
          "gustKmh": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gustkmh"
          },
          "precipMm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipmm"
          },
          "to": {
            "title": "To",
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "StopConditions",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Waypoint": {
        "properties": {
          "elevationM": {
            "title": "Elevationm",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "latLng": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Latlng",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "latLng",
          "elevationM"
        ],
        "title": "Waypoint",
        "type": "object"
      },
      "Window": {
        "properties": {
          "from": {
            "title": "From",
            "type": "integer"
          },
          "to": {
            "title": "To",
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "Window",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Hiking safety assistant API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/forecast/retry": {
      "post": {
        "description": "\"Try again\" on the not-assessable screen: asks the forecast source whether it answers now.",
        "operationId": "retry_forecast_api_forecast_retry_post",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retry Forecast"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/routes": {
      "post": {
        "description": "Route between two searched places over the official trail network.",
        "operationId": "create_route_api_routes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Route"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Route"
      }
    },
    "/api/routes/search": {
      "get": {
        "description": "Place-name search, for picking the ends of a route.",
        "operationId": "search_places_api_routes_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlaceResult"
                  },
                  "title": "Response Search Places Api Routes Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Places"
      }
    },
    "/api/routes/{route_id}": {
      "get": {
        "operationId": "get_route_api_routes__route_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "route_id",
            "required": true,
            "schema": {
              "title": "Route Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Route"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Route"
      }
    },
    "/api/routes/{route_id}/ask": {
      "post": {
        "description": "A question about the hike on `date`, answered by a language model from the assessment and the plan.\n\nEvery figure in the answer is the engine's or the plan's, filled in by the server; the model decides\nnothing. `live` makes it about this minute of a hike under way. Never fails on the model's account:\n`reason` says why an answer has no text.",
        "operationId": "ask_about_route_api_routes__route_id__ask_post",
        "parameters": [
          {
            "in": "path",
            "name": "route_id",
            "required": true,
            "schema": {
              "title": "Route Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scenario",
            "required": false,
            "schema": {
              "default": "assessed",
              "enum": [
                "assessed",
                "partial",
                "not_assessable",
                "stale"
              ],
              "title": "Scenario",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "en",
              "enum": [
                "en",
                "fr"
              ],
              "title": "Lang",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask About Route"
      }
    },
    "/api/routes/{route_id}/assessment": {
      "get": {
        "description": "Hazards for the hike on `date` (default: today in Switzerland), evaluated client-side at arrival.",
        "operationId": "get_route_assessment_api_routes__route_id__assessment_get",
        "parameters": [
          {
            "in": "path",
            "name": "route_id",
            "required": true,
            "schema": {
              "title": "Route Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scenario",
            "required": false,
            "schema": {
              "default": "assessed",
              "enum": [
                "assessed",
                "partial",
                "not_assessable",
                "stale"
              ],
              "title": "Scenario",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentData"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Route Assessment"
      }
    },
    "/api/routes/{route_id}/narration": {
      "get": {
        "description": "The assessment's hazards phrased in `lang`, with the guidance each is grounded in.\n\nSeparate from the assessment so a slow model never holds it up. Never fails on the model's\naccount: a hazard without a `body` keeps its templated copy.",
        "operationId": "get_route_narration_api_routes__route_id__narration_get",
        "parameters": [
          {
            "in": "path",
            "name": "route_id",
            "required": true,
            "schema": {
              "title": "Route Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scenario",
            "required": false,
            "schema": {
              "default": "assessed",
              "enum": [
                "assessed",
                "partial",
                "not_assessable",
                "stale"
              ],
              "title": "Scenario",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "en",
              "enum": [
                "en",
                "fr"
              ],
              "title": "Lang",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Narration"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Route Narration"
      }
    }
  }
}
