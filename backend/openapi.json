            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskTurn": {
        "description": "One earlier exchange, as the client showed it (answers already filled in).",
